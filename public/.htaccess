# Hostinger (LiteSpeed / Apache) settings for the static site in public_html
# (Vercel and Netlify ignore this file)

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always-https: switch on in hPanel (Security > SSL > Force HTTPS) once the free SSL
  # certificate is active, or uncomment these two lines. Turning it on before the
  # certificate exists breaks the site.
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www.baksheeshtech.com -> baksheeshtech.com (the address Google sees in the canonical tags)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [L,R=301]

  # the old static site used /portfolio.html
  RewriteRule ^portfolio\.html$ /portfolio/ [L,R=301]
</IfModule>

# files in /_next/static have a content hash in their name, so browsers can keep them for a year
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
